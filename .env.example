# ---- AI extraction -------------------------------------------------------
# "demo" (default): no AI calls. Synthetic sample documents use hand-written
#   fixture extractions, clearly labelled in the UI. Other uploads are stored
#   and fingerprinted but not read.
# "vertex": call Gemini on Vertex AI using Application Default Credentials
#   (locally: `gcloud auth application-default login`; on Cloud Run: the
#   service account). No API keys are used or needed.
VOLTPROOF_AI_MODE=demo
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Optional second model, tried once when the first fails or cites quotes that
# are not in the document (e.g. a Pro model). Leave empty to disable.
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_MS=45000

# ---- Storage -------------------------------------------------------------
# "local" (default): JSON + files under ./data (not durable on Cloud Run).
# "gcp": Firestore (cases, findings, reviews) + Cloud Storage (documents).
VOLTPROOF_STORAGE=local
VOLTPROOF_DATA_DIR=./data
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION=voltproof_cases
GCS_BUCKET=

# ---- Access --------------------------------------------------------------
# Shared access code required to sign in. Leave empty only for local dev.
VOLTPROOF_ACCESS_CODE=
# Secret used to sign session cookies (long random string). Required in production.
SESSION_SECRET=

# ---- Rules ---------------------------------------------------------------
BATTERY_REPORT_MAX_AGE_DAYS=90
# Extracted fields below this self-reported confidence are not used by rules
# and are sent to human review instead.
EXTRACTION_MIN_CONFIDENCE=0.7
MAX_UPLOAD_MB=10

# ---- Seller claims policy (printed in every report) ------------------------
# A battery report may be this many points below the claimed SOH and still verify it.
SOH_TOLERANCE_PTS=2
# Allowed difference between a claimed and a recorded odometer reading.
ODOMETER_TOLERANCE_KM=500
# A dealer-captured dashboard photo counts as "current" for this many days.
ODOMETER_FRESH_DAYS=30

# ---- Landing page ----------------------------------------------------------
# Origin of the marketing site allowed to POST to /api/leads (CORS), e.g. https://voltproof.example
LANDING_ORIGIN=

# ---- Forensics, OCR and registries ----------------------------------------------
# Trust list of issuer signing certificates (see trust/trusted-signers.json).
TRUSTED_SIGNERS_FILE=
# PaddleOCR service (ocr-service/). Second, independent read for photos and scans.
OCR_SERVICE_URL=
# "none" to skip Cloud Run ID tokens when calling a local OCR service.
OCR_SERVICE_AUTH=
# NZ Motor Vehicle Register open-data feature service (defaults to the current NZTA service).
NZTA_MVR_SERVICE_URL=
# Korea MLIT 자동차종합정보 API key (data.go.kr). Adapter not yet connected.
KR_CAR365_SERVICE_KEY=
